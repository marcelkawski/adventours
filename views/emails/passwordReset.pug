extends baseEmail

block content
    p Hi #{firstName},
    p Forgot your password? Please paste this link into your browser to set a new one: #{url} Your token is valid for 10 minutes.
    p (Website for this action not implemented yet)
    table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
        tbody
            tr
                td(align='left')
                    table(role='presentation', border='0', cellpadding='0', cellspacing='0')
                        tbody
                            tr
                                td
                                    a(href=`${url}`, target='_blank') Reset your password
    p If you did not forget your password, ignore this email.